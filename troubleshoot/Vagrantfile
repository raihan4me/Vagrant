Vagrant.configure("2") do |config|
  config.vm.box         = "devops/ubuntu2404"
  config.vm.box_version = "1.1.0"
  config.vm.hostname    = "tshoot-01"

  config.vm.network "forwarded_port", guest: 80, host: 8095, host_ip: "127.0.0.1"
  config.vm.synced_folder "content", "/srv/content"

  config.vm.provision "setup", type: "shell", path: "provision.sh"

  config.vm.provider "docker" do |d|
    d.name = "tshoot"
  end
end
